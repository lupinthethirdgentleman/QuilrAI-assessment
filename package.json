    "task4:mock": "tsx src/task4-model-router/mock-providers.ts",
    "task4": "tsx src/task4-model-router/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\""
