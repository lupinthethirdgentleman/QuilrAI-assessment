    "task2:mock": "tsx src/task2-mcp-gateway/mock-mcp-server.ts",
    "task2": "tsx src/task2-mcp-gateway/gateway.ts",
    "task2:token": "tsx src/task2-mcp-gateway/mint-token.ts",
